# 複製成 infra/.env 再改：cp .env.example .env
# 只填你要開的服務；其餘保留預設即可。這個檔不要 commit。

# ── 密碼（必填，對應服務沒設就拒絕啟動）──
NEO4J_PASSWORD=          # M4，至少 8 字元
POSTGRES_PASSWORD=       # M5

# ── 埠號（和本機其他服務撞埠時才改）──
OLLAMA_PORT=11434
CHROMA_PORT=8000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
POSTGRES_PORT=5432
N8N_PORT=5678

# ── 其他 ──
OLLAMA_CONTEXT_LENGTH=8192
NEO4J_HEAP=1G
POSTGRES_USER=agent
POSTGRES_DB=agent
TZ=Asia/Taipei
