# 本地模型（預設）：Ollama 的 OpenAI 相容端點，不需要金鑰
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3

# 雲端備援（選填）：任何 OpenAI 相容服務，例如 DeepSeek
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat
CLOUD_API_KEY=

# 其他供應商（選填；沒填的 notebook 段落會自動跳過）
OPENAI_API_KEY=          # M1-06 多模態
OPENROUTER_API_KEY=      # M1-07
ANTHROPIC_API_KEY=       # M1-07、M5-08 Claude Agent SDK

# 可觀測性平台（選填，M8-05、06）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OPIK_API_KEY=
OPIK_WORKSPACE=

# 旗艦專案基礎服務（projects/incident-autonomous-agent/docker-compose.yml）
POSTGRES_USER=agent
POSTGRES_PASSWORD=
POSTGRES_DB=agent
NEO4J_USER=neo4j
NEO4J_PASSWORD=
