# 本地模型（備援；沒填雲端金鑰時就是唯一端點）：Ollama 的 OpenAI 相容端點，不需要金鑰
# embedding 一律走本地
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:3b
EMBED_MODEL=bge-m3

# 雲端（優先；選填）：任何 OpenAI 相容服務，例如 DeepSeek。填了 CLOUD_API_KEY 就先走雲端，失敗再退回本地
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_MODEL=deepseek-chat
# 換 OpenAI：CLOUD_BASE_URL=https://api.openai.com/v1、CLOUD_MODEL=gpt-4.1-mini
# （GPT-5 系列不收 max_tokens／temperature，notebook 會報 400；DeepSeek 不支援 json_schema 結構化輸出）
CLOUD_API_KEY=

# 其他供應商（選填；沒填的 notebook 段落會自動跳過）
OPENAI_API_KEY=          # M1-06 多模態
OPENROUTER_API_KEY=      # M1-07
DEEPSEEK_API_KEY=        # M1-07（也可直接填進上面的 CLOUD_API_KEY）
ANTHROPIC_API_KEY=       # M1-07、M5-08 Claude Agent SDK

# 可觀測性平台（選填，M8-05、06）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OPIK_API_KEY=
OPIK_WORKSPACE=

# 旗艦專案基礎服務（projects/incident-autonomous-agent/docker-compose.yml）
POSTGRES_USER=agent
POSTGRES_PASSWORD=
POSTGRES_DB=agent
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 值班助理：預設免模型 demo；live 使用 Deep Agents + MCP
ONCALL_MODE=demo
ONCALL_CHECKPOINT=memory
ONCALL_DATA_DIR=.oncall-data
# postgres 模式必填，密碼需 URL encode；與 Compose 的 PostgreSQL 相符
ONCALL_DATABASE_URL=
# live 模式必填；本機 demo 可不填，設定後所有 /api 請求需 Bearer token
ONCALL_API_TOKEN=
# 選填；未設定／連線失敗時使用本地拓撲
ONCALL_NEO4J_URI=
# 選填；預設沿用 LOCAL_MODEL，模型須支援工具呼叫
ONCALL_MODEL=
ONCALL_MODEL_API_KEY=
# 選填 LangSmith；內容可能包含調查資料，啟用前確認可上傳
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=oncall-agent
